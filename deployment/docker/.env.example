# Copy to .env in this directory before: ./scripts/compose-up.sh up -d
# Provider keys belong in .env.secrets only (cp .env.secrets.example .env.secrets).
# Provider keys belong in .env.secrets as SBX_REAL_* (see .env.secrets.example).
#
# One switch for nono layout:
LITELLM_NONO_MODE=direct
#   direct  → ./scripts/compose-up.sh up -d
#   sidecar → LITELLM_NONO_MODE=sidecar ./scripts/compose-up.sh up -d
#             (or: docker compose -f docker-compose.with-nono-proxy.yml up -d)
#
# Sidecar only: shared secret for `nono proxy --pass` and litellm phantom auth
NONO_PROXY_PASS=
# Credential proxy listen port (must not be 4000 — LiteLLM uses 4000; K8s pods share one network namespace)
# NONO_PROXY_LISTEN_PORT=4010
# NONO_CREDENTIAL_PROXY_PORT=4010
# NONO_PROXY_PUBLISH_PORT=4010   # host map for nono-proxy (litellm stays LITELLM_PORT=4000)

# Proxy ops secrets (visible inside the sandboxed LiteLLM process):
#   printf 'LITELLM_MASTER_KEY=sk-%s\nLITELLM_SALT_KEY=sk-%s\n' "$(openssl rand -hex 32)" "$(openssl rand -hex 32)"
LITELLM_MASTER_KEY=

# Proxy config mount (default in compose: config.example.yaml; use ./config.yaml for a local gitignored override)
# LITELLM_CONFIG_PATH=./config.yaml

# Postgres (required)
POSTGRES_DB=litellm
POSTGRES_USER=llmproxy
POSTGRES_PASSWORD=
DATABASE_HOST=db
DATABASE_PORT=5432
# LITELLM_SALT_KEY=   # required with Postgres (encrypts DB-stored credentials)
# DATABASE_URL is assembled by docker-compose.yml from the vars above.

# K8s/Talos sidecar in-pod (optional; Docker Compose uses nono-proxy hostname by default)
# NONO_CREDENTIAL_PROXY_HOST=127.0.0.1

NONO_VERSION=0.81.0
# LiteLLM semver from canonical tag v1.106.8-v0.81.0 → v1.106.8 (selects ghcr.io/berriai/litellm-non_root tag).
LITELLM_RELEASE_TAG=v1.106.8
# Override base: ghcr.io/berriai/litellm-non_root:${LITELLM_RELEASE_TAG}
# LITELLM_BASE_IMAGE=
# Submodule compile instead of GHCR: LITELLM_BUILD_FROM_SOURCE=1 (see scripts/build-local-image.sh)

# Optional nono flags (e.g. extra egress domains for plugins):
# NONO_RUN_ARGS=--allow-domain your.internal.service
