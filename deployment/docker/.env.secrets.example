# Copy to .env.secrets (gitignored). Real upstream LLM credentials for nono only.
#
# Naming: SBX_REAL_<PROVIDER_ENV> — supervisor/sidecar only (not the sandboxed LiteLLM child).
#   e.g. SBX_REAL_OPENROUTER_API_KEY  (matches env:// in litellm.json / litellm-credentials.json)
#
# NEVER set bare OPENAI_API_KEY etc. here — those are phantom names for LiteLLM (PHANTOM_KEY_*).

SBX_REAL_OPENAI_API_KEY=
SBX_REAL_ANTHROPIC_API_KEY=
SBX_REAL_GEMINI_API_KEY=
SBX_REAL_OPENROUTER_API_KEY=
