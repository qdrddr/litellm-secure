# Copy to .env.secrets (gitignored). Real upstream credentials for nono only.
#
# Use either convention (add providers as needed — no image rebuild):
#   NONO_<ENV_NAME>      e.g. NONO_OPENROUTER_API_KEY  (matches env:// in litellm-credentials.json)
#   NONO_REAL_<ENV_NAME> e.g. NONO_REAL_OPENROUTER_API_KEY  (mapped to NONO_* on nono-proxy startup)
#
# NEVER set bare OPENAI_API_KEY etc. here — those are phantom names for the LiteLLM child (PHANTOM_KEY_*).

NONO_OPENAI_API_KEY=
NONO_ANTHROPIC_API_KEY=
NONO_GEMINI_API_KEY=
NONO_OPENROUTER_API_KEY=
