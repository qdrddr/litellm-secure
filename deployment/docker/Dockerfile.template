# Nono sandbox on official LiteLLM non_root (default ghcr.io/berriai/litellm-non_root:vX.Y.Z).
# scripts/build-*-image.sh set LITELLM_BASE_IMAGE from the canonical git tag (v1.106.8-v0.81.0 → v1.106.8).
ARG LITELLM_BASE_IMAGE=ghcr.io/berriai/litellm-non_root:v1.106.8
FROM ${LITELLM_BASE_IMAGE}

# Required: pass --build-arg LITELLM_RELEASE_TAG=vX.Y.Z (scripts/build-*-image.sh set this from the canonical tag).
ARG LITELLM_RELEASE_TAG
ARG NONO_VERSION=0.81.0
ARG TARGETARCH

RUN test -n "${LITELLM_RELEASE_TAG}" && [ "${LITELLM_RELEASE_TAG}" != unknown ]

ENV LITELLM_RELEASE_TAG=${LITELLM_RELEASE_TAG}

LABEL org.opencontainers.image.version="${LITELLM_RELEASE_TAG}-v${NONO_VERSION}"

USER root

RUN set -eux; \
    apk add --no-cache wget ca-certificates; \
    case "${TARGETARCH}" in \
      amd64) NONO_ARCH="x86_64-unknown-linux-musl" ;; \
      arm64) NONO_ARCH="aarch64-unknown-linux-gnu" ;; \
      *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    wget -q -O /tmp/nono.tar.gz \
      "https://github.com/nolabs-ai/nono/releases/download/v${NONO_VERSION}/nono-v${NONO_VERSION}-${NONO_ARCH}.tar.gz"; \
    python3 -c "import tarfile; tarfile.open('/tmp/nono.tar.gz', 'r:gz').extractall('/tmp')"; \
    NONO_BIN="$(find /tmp -maxdepth 2 -type f -name nono | head -1)"; \
    test -n "${NONO_BIN}"; \
    install -m 0755 "${NONO_BIN}" /usr/local/bin/nono; \
    rm -rf /tmp/nono.tar.gz /tmp/nono*; \
    apk del wget || true; \
    rm -rf /var/cache/apk/*

# Match ghcr.io/berriai/litellm-non_root runtime user (nobody / 65534, HOME=/app).
ARG LITELLM_RUNTIME_UID=65534
ARG LITELLM_RUNTIME_GID=65534

RUN mkdir -p /app/.config/nono/profiles /app/.nono \
  && HOME=/app nono pull nolabs-ai/claude

COPY nono/profiles/litellm.json /app/.config/nono/profiles/litellm.json
COPY config.example.yaml /app/config.example.yaml
COPY nono/nono-entrypoint.sh /usr/local/bin/nono-entrypoint.sh
RUN mkdir -p /usr/local/lib/litellm-secure /app/.nono
COPY nono/litellm_nono_env.py /usr/local/lib/litellm-secure/litellm_nono_env.py
# Install into venv site-packages: nono strips PYTHONPATH from the sandboxed child.
COPY nono/sitecustomize/sitecustomize.py /tmp/litellm-secure-sitecustomize.py
RUN chmod +x /usr/local/bin/nono-entrypoint.sh \
  && SITE="$(/app/.venv/bin/python -c 'import site; print(site.getsitepackages()[0])')" \
  && install -m 0644 /tmp/litellm-secure-sitecustomize.py "${SITE}/sitecustomize.py" \
  && rm -f /tmp/litellm-secure-sitecustomize.py \
  && mkdir -p /app/.local/state/nono \
  && chown -R "${LITELLM_RUNTIME_UID}:${LITELLM_RUNTIME_GID}" \
    /app/.config/nono /app/.nono /usr/local/lib/litellm-secure /app/.local/state

# Pin Prisma query-engine port (sitecustomize.py + nono listen_port/open_port 51245).
ENV LITELLM_PRISMA_ENGINE_PORT=51245

WORKDIR /app

EXPOSE 4000/tcp

# USER must be numeric: ghcr.io/berriai/litellm-non_root uses 65534 (nobody).
USER 65534:65534
ENV HOME=/app

ENTRYPOINT ["/usr/local/bin/nono-entrypoint.sh"]
CMD ["litellm"]
