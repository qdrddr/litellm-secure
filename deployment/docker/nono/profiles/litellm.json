{
  "extends": "nolabs-ai/claude",
  "meta": {
    "name": "litellm",
    "version": "1.0.0",
    "description": "LiteLLM proxy in Docker: nono sandbox with proxy credential injection for LLM providers."
  },
  "environment": {
    "deny_vars": [
      "SBX_REAL_*",
      "NONO_PROXY_PASS",
      "NONO_PROXY_TOKEN"
    ]
  },
  "filesystem": {
    "allow": [
      "/app/.staging",
      "/app/.cache",
      "/app/.cache/claude",
      "/app/.claude",
      "/app/.local/state/claude",
      "/app/.config/nono",
      "/tmp",
      "/var/lib/litellm",
      "/var/run/litellm",
      "/run/litellm"
    ],
    "read": [
      "/app/.venv",
      "/app/litellm",
      "/app/docker",
      "/opt/prisma"
    ]
  },
  "network": {
    "network_profile": "developer",
    "allow_domain": [
      "api.openai.com",
      "openai.com",
      "api.anthropic.com",
      "anthropic.com",
      "generativelanguage.googleapis.com",
      "googleapis.com",
      "openrouter.ai",
      "docs.litellm.ai"
    ],
    "listen_port": [4000, 4001, 3000, 51245],
    "open_port": [5432, 51245, 6432],
    "credentials": ["openai", "anthropic", "gemini", "openrouter"],
    "custom_credentials": {
      "openai": {
        "upstream": "https://api.openai.com/v1",
        "credential_key": "env://SBX_REAL_OPENAI_API_KEY",
        "env_var": "OPENAI_API_KEY",
        "inject_header": "Authorization",
        "credential_format": "Bearer {}"
      },
      "anthropic": {
        "upstream": "https://api.anthropic.com",
        "credential_key": "env://SBX_REAL_ANTHROPIC_API_KEY",
        "env_var": "ANTHROPIC_API_KEY",
        "inject_header": "x-api-key",
        "credential_format": "{}"
      },
      "gemini": {
        "upstream": "https://generativelanguage.googleapis.com",
        "credential_key": "env://SBX_REAL_GEMINI_API_KEY",
        "env_var": "GEMINI_API_KEY",
        "inject_header": "x-goog-api-key",
        "credential_format": "{}"
      },
      "openrouter": {
        "upstream": "https://openrouter.ai/api/v1",
        "credential_key": "env://SBX_REAL_OPENROUTER_API_KEY",
        "env_var": "OPENROUTER_API_KEY",
        "inject_header": "Authorization",
        "credential_format": "Bearer {}"
      }
    }
  }
}
