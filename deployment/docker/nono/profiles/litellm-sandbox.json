{
  "extends": "nolabs-ai/claude",
  "meta": {
    "name": "litellm-sandbox",
    "version": "1.0.0",
    "description": "LiteLLM under nono run without local custom_credentials; provider traffic via localhost forward to nono-proxy sidecar."
  },
  "filesystem": {
    "allow": [
      "/app/.staging",
      "/app/.cache",
      "/app/.config/nono",
      "/app/.venv",
      "/app/litellm",
      "/app/docker",
      "/tmp",
      "/var/lib/litellm",
      "/var/run/litellm",
      "/run/litellm",
      "/opt/prisma",
      "/app/.nono"
    ]
  },
  "network": {
    "network_profile": "developer",
    "listen_port": [4000, 4001, 3000, 51245],
    "open_port": [5432, 51245, 18080]
  }
}
