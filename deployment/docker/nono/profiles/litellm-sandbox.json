{
  "extends": "nolabs-ai/claude",
  "meta": {
    "name": "litellm-sandbox",
    "version": "1.0.0",
    "description": "LiteLLM under nono run without local custom_credentials; provider traffic via localhost forward to nono-proxy sidecar."
  },
  "environment": {
    "deny_vars": ["SBX_REAL_*"]
  },
  "filesystem": {
    "allow": [
      "/app/.staging",
      "/app/.cache",
      "/app/.cache/claude",
      "/app/.claude",
      "/app/.local/state/claude",
      "/app/.config/nono",
      "/tmp",
      "/var/lib/litellm",
      "/var/run/litellm",
      "/run/litellm"
    ],
    "read": [
      "/app/.venv",
      "/app/litellm",
      "/app/docker",
      "/opt/prisma"
    ]
  },
  "network": {
    "network_profile": "developer",
    "credentials": [],
    "custom_credentials": {},
    "no_proxy": ["127.0.0.1", "localhost"],
    "listen_port": [4000, 4001, 3000, 51245, 6379, 6432],
    "open_port": [5432, 51245, 6432, 18080, 6379]
  }
}
